# Server configuration only. Never place service-role or provider keys in browser code.
# Use the hosting provider's secret manager for production.
VESSEL_BACKEND=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VESSEL_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=

# Exact app origin. Required for Google/Apple redirects; use HTTPS in production.
VESSEL_APP_URL=http://127.0.0.1:5173
